{
  "manifest_version": 3,
  "name": "Learn with Bookmarks - Edge Companion",
  "version": "1.0.4",
  "description": "Applies locally generated learning bookmark trees through Edge's official bookmarks API.",
  "key": "",
  "permissions": [
    "bookmarks"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:*"
  }
}
